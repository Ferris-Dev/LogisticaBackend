# Referencia de las variables de entorno de la API.
# En Railway se definen en: servicio API → Variables. En local no hace falta ninguna:
# se usan appsettings.Development.json y user-secrets (ver README).

# Cadena de conexión en formato URI. En Railway: ${{Postgres.DATABASE_URL}}
# Si no existe, se usa ConnectionStrings:DefaultConnection de appsettings.Development.json.
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/tracking_logistico

# Puerto HTTP. Railway lo inyecta solo; en local se usa 8080.
PORT=8080

# Aplicar migraciones (y datos de prueba) al arrancar. true | false
RUN_MIGRATIONS=true

# Publicar Swagger UI en /swagger (también en Production). true | false
ENABLE_SWAGGER=true

# Development carga appsettings.Development.json y user-secrets. En Railway: Production.
ASPNETCORE_ENVIRONMENT=Production
